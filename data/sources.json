[
  {
    "name": "LandSale4U (Live Land Listings)",
    "type": "wp_rei_land",
    "enabled": true,
    "url": "https://landsale4u.com/wp-json/wp/v2/rei_land",
    "perPage": 50,
    "maxPages": 5
  },
  {
    "name": "LandElevated (Live Land Listings)",
    "type": "landelevated_home",
    "enabled": true,
    "url": "https://landelevated.com",
    "maxMentions": 300
  },
  {
    "name": "Sample JSON Listings",
    "type": "json",
    "enabled": false,
    "path": "data/sample-listings.json",
    "mappings": {
      "id": "id",
      "title": "title",
      "price": "price",
      "acreage": "acreage",
      "lat": "lat",
      "lon": "lon",
      "url": "url",
      "description": "description",
      "city": "city",
      "state": "state"
    }
  },
  {
    "name": "Sample CSV Listings",
    "type": "csv",
    "enabled": false,
    "path": "data/sample-listings.csv",
    "mappings": {
      "id": "listing_id",
      "title": "headline",
      "price": "list_price",
      "acreage": "acres",
      "lat": "latitude",
      "lon": "longitude",
      "url": "listing_url",
      "description": "notes",
      "city": "city",
      "state": "state"
    }
  },
  {
    "name": "Example RSS Feed",
    "type": "rss",
    "enabled": false,
    "url": "https://example.com/land-listings.rss",
    "mappings": {
      "id": "guid",
      "title": "title",
      "url": "link",
      "description": "contentSnippet"
    },
    "defaults": {
      "state": "PA"
    }
  }
]
